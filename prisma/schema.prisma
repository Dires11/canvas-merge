generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model CanvasAccount {
  id              String    @id @default(uuid())
  userId          String    @db.Uuid
  domain          String
  name            String
  accessToken     String
  expiredAt       DateTime? @map("expired_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  avatarUrl       String
  accountCanvasId Int

  @@unique([userId, domain, accountCanvasId])
  @@schema("public")
}

model UserSettings {
  userId            String   @id @db.Uuid
  preferredTimezone String?  @map("preferred_timezone")
  detectedTimezone  String   @default("UTC") @map("detected_timezone")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt

  @@schema("public")
}

model CourseMetadata {
  courseId Int
  domain   String
  userId   String

  l Float
  c Float
  h Float

  updatedAt DateTime @updatedAt

  // The unique "fingerprint" for a course setting
  @@id([courseId, domain, userId])
  @@schema("public")
}
